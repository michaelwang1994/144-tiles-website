{
  "name": "144-tiles-website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run generate-form-config && vite",
    "generate-form-config": "tsc scripts/generate-form-config.ts --ignoreConfig --module esnext --moduleResolution bundler --target esnext --lib esnext,dom --skipLibCheck --types node --outDir /tmp/form-config-gen && node /tmp/form-config-gen/generate-form-config.js",
    "generate-receipts": "tsx scripts/generate-receipts.ts",
    "generate-receipts:dry-run": "tsx scripts/generate-receipts.ts --dry-run",
    "build": "npm run generate-form-config && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.5",
    "puppeteer-core": "^25.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "playhtml": "^2.9.0"
  }
}
